# Flash: 16 MB Quad SPI
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: 8 MB Octal (OPI). Forkert tilstand giver boot-loop på N16R8.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Sikker OTA: ny firmware rulles tilbage, hvis den ikke melder sig sund
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Crash-dump gemmes i flash til fejlsøgning
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# System
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_WS_SUPPORT=y

# Bus-interruptet skal køre, også mens der skrives til flash (NVS, OTA)
CONFIG_GPTIMER_ISR_IRAM_SAFE=y

# Netværk: alt på kerne 0, så kerne 1 er fri til IHC-bussen
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_LOCAL_HOSTNAME="ihc-bridge"
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y

# Webserver: browsere sender ofte headere på over 512 bytes
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1536
